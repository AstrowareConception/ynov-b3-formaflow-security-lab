{
  "info": { "name": "FormaFlow Security Lab - preuves locales", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Collection strictement locale, données synthétiques, requêtes bornées par les scénarios." },
  "variable": [{ "key": "token", "value": "" }],
  "item": [
    { "name": "Santé", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Connexion Alice synthétique", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.accessToken || '');"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"alice.learner@example.test\",\"password\":\"Synthetic-Alice-2026!\"}" }, "url": "{{baseUrl}}/api/auth/login" } },
    { "name": "Recherche légitime", "request": { "method": "GET", "url": "{{baseUrl}}/api/catalog?q=S%C3%A9curit%C3%A9" } },
    { "name": "Commande Alice", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }], "url": "{{baseUrl}}/api/orders/30000000-0000-4000-8000-000000000001" } },
    { "name": "Export Alice", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/export" } }
  ]
}
