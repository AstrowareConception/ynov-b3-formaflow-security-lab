{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formaflow.example.test/events/order-confirmed.v1.schema.json",
  "title": "OrderConfirmed.v1",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "properties": {
        "eventType": {"const": "OrderConfirmed.v1"},
        "version": {"const": 1},
        "producer": {"const": "order-service"},
        "payload": {
          "type": "object",
          "required": ["orderId", "customerAccountId", "confirmedAt", "lines", "total"],
          "properties": {
            "orderId": {"type": "string", "pattern": "^ORD-[0-9]{4}-[0-9]{6}$"},
            "customerAccountId": {"type": "string", "pattern": "^ACC-[0-9]{4}$"},
            "confirmedAt": {"type": "string", "format": "date-time"},
            "lines": {"type": "array", "minItems": 1},
            "total": {
              "type": "object",
              "required": ["amountMinor", "currency"],
              "properties": {"amountMinor": {"type": "integer", "minimum": 0}, "currency": {"const": "EUR"}},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

