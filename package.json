{
  "name": "ynov-b3-formaflow-security-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Reference pedagogique locale Securite applicative et RGPD",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "setup": "node scripts/check-versions.mjs && npm ci",
    "start": "node scripts/compose.mjs remediated",
    "start:vulnerable": "node scripts/compose.mjs vulnerable",
    "start:remediated": "node scripts/compose.mjs remediated",
    "start:cookie": "node scripts/compose.mjs cookie",
    "stop": "node scripts/compose.mjs stop",
    "reset-data": "node scripts/compose.mjs reset",
    "smoke": "node scripts/smoke.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint apps packages tests --max-warnings=0",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:application": "jest --runInBand tests/application",
    "test:architecture": "jest --runInBand tests/architecture",
    "test:contracts": "jest --runInBand tests/contracts",
    "test:security": "node scripts/security-tests.mjs",
    "test:postgres": "node scripts/integration-tests.mjs postgres",
    "test:rabbitmq": "node scripts/integration-tests.mjs rabbitmq",
    "test:e2e": "node scripts/integration-tests.mjs e2e",
    "test:privacy": "jest --runInBand tests/privacy && node scripts/validate-privacy.mjs",
    "test:privacy:e2e": "node scripts/privacy-e2e.mjs",
    "contracts": "node scripts/validate-contracts.mjs",
    "diagrams": "node scripts/validate-diagrams.mjs",
    "tls": "node scripts/tls.mjs",
    "validate": "python scripts/validate_repository.py",
    "test:negative": "python scripts/test_validator_negative.py",
    "handoff": "python handoff/audit-method-reference/scripts/validate_handoff.py",
    "package": "python scripts/build_release.py",
    "quality": "npm run validate && npm run test:negative && npm run contracts && npm run diagrams && npm run typecheck && npm run lint && npm test && npm run build && npm run package"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "amqplib": "0.10.9",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@nestjs/testing": "11.2.3",
    "@types/bcrypt": "6.0.0",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "selfsigned": "3.0.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
