{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/contracts/enrollment-created.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "enrollment.created.v1" },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "data": { "type": "object", "additionalProperties": false, "required": ["enrollmentId", "userId", "courseId"], "properties": { "enrollmentId": { "type": "string", "format": "uuid" }, "userId": { "type": "string", "format": "uuid" }, "courseId": { "type": "string", "format": "uuid" } } }
  }
}
