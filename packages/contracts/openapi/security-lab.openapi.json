{
  "openapi": "3.1.0",
  "info": { "title": "FormaFlow Security Lab", "version": "1.0.0" },
  "servers": [{ "url": "http://127.0.0.1:3000" }],
  "paths": {
    "/health": { "get": { "responses": { "200": { "description": "Profil local actif" } } } },
    "/api/auth/login": { "post": { "responses": { "200": { "description": "Jeton synthétique" }, "401": { "description": "Échec maîtrisé" } } } },
    "/api/catalog": { "get": { "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 120 } }], "responses": { "200": { "description": "Catalogue" } } } },
    "/api/profile": { "get": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Profil minimisé" } } } },
    "/api/profile/bio": { "post": { "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Bio enregistrée" } } } },
    "/api/orders/{id}": { "get": { "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Commande autorisée" }, "403": { "description": "Propriétaire requis" } } } },
    "/api/enrollments": { "post": { "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Inscription et événement" } } } },
    "/api/export": { "get": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Export du sujet" } } } },
    "/api/account": { "delete": { "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Demande distribuée" } } } },
    "/cookie/login": { "post": { "responses": { "200": { "description": "Session cookie isolée" } } } },
    "/cookie/account/delete": { "post": { "responses": { "201": { "description": "Opération critique cookie" }, "403": { "description": "Défense CSRF" } } } }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } } }
}
